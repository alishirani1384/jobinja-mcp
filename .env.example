# Jobinja account (optional; used by the `login` tool when called without arguments)
JOBINJA_EMAIL=
JOBINJA_PASSWORD=

# Storage and caching
# JOBINJA_DATA_DIR=~/.jobinja-mcp
# JOBINJA_CACHE=1
# JOBINJA_CACHE_TTL=600
# JOBINJA_REDIS_URL=redis://localhost:6379/0

# Politeness towards jobinja.ir
# JOBINJA_MIN_REQUEST_INTERVAL=0.4
# JOBINJA_MAX_RETRIES=3
# JOBINJA_TIMEOUT=30

# Playwright browser login
# JOBINJA_BROWSER_HEADLESS=0

# Server
# JOBINJA_MCP_TRANSPORT=stdio
# JOBINJA_MCP_HOST=127.0.0.1
# JOBINJA_MCP_PORT=8000
# JOBINJA_MCP_PATH=/mcp
# JOBINJA_MCP_AUTH_TOKEN=change-me
# JOBINJA_LOG_LEVEL=INFO
